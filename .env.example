# Copy this file to .env and replace only the RESOURCE NAMES.
# Do not place Azure passwords, access keys, SAS tokens or PATs here.

AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=rg-ecommerce-de
AZURE_LOCATION=uksouth

# ADLS Gen2
AZURE_STORAGE_ACCOUNT=stecbehaviourXXXX
ADLS_FILE_SYSTEM=ecommerce
ADLS_LANDING_DIR=landing
ADLS_BRONZE_DIR=bronze
ADLS_SILVER_DIR=silver
ADLS_GOLD_DIR=gold

# Azure Data Factory
ADF_FACTORY_NAME=adf-ecommerce-de-XXXX
ADF_PIPELINE_NAME=PL_ECOMMERCE_BEHAVIOUR_PIPELINE

# Azure SQL
AZURE_SQL_SERVER=sql-ecommerce-de-XXXX
AZURE_SQL_DATABASE=ECommerceAnalyticsDB
AZURE_SQL_CONNECTIONSTRING=Server=sql-ecommerce-de-XXXX.database.windows.net;Database=ECommerceAnalyticsDB;Authentication=ActiveDirectoryDefault;Encrypt=yes;TrustServerCertificate=no;

# Optional Databricks resource names only (no PAT)
DATABRICKS_WORKSPACE_NAME=dbw-ecommerce-de-XXXX
